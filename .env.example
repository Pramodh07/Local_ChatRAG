# AUTH_MODE is the legacy shorthand; AUTH_PROVIDER and DATABASE_PROVIDER override it.
AUTH_MODE=local
# AUTH_PROVIDER=local
# DATABASE_PROVIDER=local
# DATABASE_PROVIDER=postgres
# PGLITE_DATA_DIR=.local-data/pglite
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# --- Supabase ingestion worker (required for document upload + RAG) -----------
# Server-only. Never prefix these with NEXT_PUBLIC_: Next.js embeds public
# variables into the browser bundle.
# Generate the worker secret with: openssl rand -base64 32   (at least 32 chars).
SUPABASE_SERVICE_ROLE_KEY=
ATLAS_INGESTION_WORKER_SECRET=
# Documents always use the private `document-uploads` bucket created by 0007.
