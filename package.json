{
  "name": "atlas-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:db": "vitest run tests/db",
    "db:types": "node scripts/generate-db-types.mjs",
    "db:types:check": "node scripts/generate-db-types.mjs --check",
    "db:push": "supabase db push --linked --yes",
    "local:import": "node scripts/import-local-data.mjs",
    "local:import:dry": "node scripts/import-local-data.mjs --dry-run",
    "check": "pnpm typecheck && pnpm lint && pnpm db:types:check && pnpm test && pnpm build",
    "verify:agent": "node scripts/agent/check.mjs",
    "verify:fast": "node scripts/agent/check.mjs --only typecheck,lint,db:types",
    "verify:json": "node scripts/agent/check.mjs --json"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "next": "^16.4.6",
    "openai": "^7.59.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "unpdf": "^2.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@electric-sql/pglite-pgvector": "0.0.18",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
